# ============================================================
# SOLVIA NOVA — ENVIRONMENT CONFIGURATION
# ============================================================

# Telegram Admin Bot Integration
# 1. Buat bot baru di Telegram via @BotFather -> Salin token bot Anda
# 2. Dapatkan chat ID Telegram Anda via @userinfobot atau kirim pesan ke bot Anda
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_chat_id_here

# Website Base URL (untuk Webhook & tautan tombol bot)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database Configuration (MySQL / MariaDB XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=solvianova_db
